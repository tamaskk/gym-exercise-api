# ---- Application ----
PORT=3000
NODE_ENV=development

# ---- Database (MongoDB) ----
# MongoDB connection string. Atlas SRV URI or a local mongod.
# Include a database name in the path, e.g. .../exercise-api?retryWrites=true
MONGODB_URI=mongodb://127.0.0.1:27017/exercise-api

# ---- Source API (ExerciseDB v1 by AscendAPI) ----
SOURCE_API_BASE_URL=https://oss.exercisedb.dev/api/v1
# Per-request timeout (ms)
SOURCE_API_TIMEOUT_MS=15000
# Page size used while walking the source pagination (max 25 enforced by source)
SYNC_PAGE_SIZE=25
# Delay between source page requests (ms) to respect rate limits
SYNC_REQUEST_DELAY_MS=250
# Max retry attempts per source request on transient/429 failures
SYNC_MAX_RETRIES=5